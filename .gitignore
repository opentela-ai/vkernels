# Build directories
/build/
/build-*/
/out/
/out-*/

# CMake
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
*.cmake.bak

# Compiled artifacts (keep them inside dist/ for wheel publishing)
*.o
*.obj
src/python/vkernels/_core*.so
*.a
*.dylib
*.exe
vkernels_unit_tests
vkernels_bench

# CUDA
*.cubin
*.fatbin
*.ptx

# Docker profiling artifacts (generated by docker/run-profile.sh)
docker/bench
docker/*.nsys-rep
docker/*.ncu-rep
docker/*.sqlite

# Coverage
*.gcno
*.gcda
*.gcov
/coverage/
*.gcov.info
coverage.info

# Python
__pycache__/
.pytest_cache/
*.egg-info/
.venv/
venv/

# Wheels (built by meta/scripts/build_wheel.sh)
# Allow .whl in dist/ but not the temporary .so copies in the source tree.
!dist/

# Rust (bindings under src/rust/)
/src/rust/target/

# Editor / OS
.vscode/
.idea/
.DS_Store
*~
.*.swp

# Local agent / tool config (never track -- machine-local).
# These were swept into a commit by a stray `git add -A`; keep them
# out of the shared tree.
.pi/
.codex/
.entire/
.rcc/

# Local vendored reference trees + scratch blobs (never track).
# work/k45/vllm/... is a local vLLM install copied in for reference;
# *.tar under work/ is large binary scratch.
work/

# build
build_host
/dist/