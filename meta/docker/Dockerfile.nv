# meta/docker/Dockerfile.nv
#
# Build container for vkernels with NVIDIA CUDA support.
# Uses nvcr.io/nvidia/pytorch:26.07-py3, which bundles:
#   - CUDA toolkit (the host supplies the NVIDIA kernel driver)
#   - PyTorch with CUDA backend
#   - Python 3.12+
#   - Ubuntu 24.04 base
# The base image includes NCCL runtime + development packages. This Dockerfile
# verifies their exact version so vkernels can compile and run collective code
# without a host NCCL install.
#
# Build (from vkernels repo root):
#   podman build -t vkernels:cuda -f meta/docker/Dockerfile.nv .
#
# Run tests + benchmarks:
#   podman run --rm --gpus all --ipc=host vkernels:cuda
#
# Run interactively:
#   podman run --gpus all -it vkernels:cuda bash
#
# Profile a benchmark:
#   podman run --gpus all --cap-add SYS_ADMIN \
#       vkernels:cuda nsys profile -o /tmp/report \
#       /workspace/vkernels/build-cuda/benchmarks/moe_bench
#
# Override target architectures at build time:
#   podman build --build-arg CUDA_ARCHS="80;86;90" \
#       -t vkernels:cuda -f meta/docker/Dockerfile.nv .

FROM nvcr.io/nvidia/pytorch:26.07-py3@sha256:2140e699b3beaf7f96a0081fd9c9406bc3832b435cdb60dfa2d261f7d2f34a1c AS toolchain

# Build-time arguments
ARG CUDA_ARCHS=90
ARG NCCL_PACKAGE_VERSION=2.30.7-1+cuda13.3

ENV DEBIAN_FRONTEND=noninteractive

# ------------------------------------------------------------------
# System dependencies
# ------------------------------------------------------------------
RUN apt-get update && apt-get install -y --no-install-recommends \
    cmake ninja-build \
    git curl ca-certificates wget \
    && rm -rf /var/lib/apt/lists/*

RUN test "$(dpkg-query -W -f='${Version}' libnccl2)" = "${NCCL_PACKAGE_VERSION}" \
    && test "$(dpkg-query -W -f='${Version}' libnccl-dev)" = "${NCCL_PACKAGE_VERSION}" \
    && dpkg-query -W libnccl2 libnccl-dev \
    && test -f /usr/include/nccl.h \
    && ldconfig -p | grep -q 'libnccl\.so' \
    && nvcc --version \
    && test -f /usr/local/cuda/targets/x86_64-linux/lib/stubs/libcuda.so \
    && ln -sf libcuda.so /usr/local/cuda/targets/x86_64-linux/lib/stubs/libcuda.so.1

FROM toolchain AS vkernels

ARG CUDA_ARCHS=90

# ------------------------------------------------------------------
# vkernels: build library + benchmarks + tests
# ------------------------------------------------------------------
WORKDIR /workspace/vkernels
COPY . .

RUN rm -rf build-cuda && \
    cmake -B build-cuda -G Ninja \
    -DCMAKE_CUDA_ARCHITECTURES="${CUDA_ARCHS}" \
    -DVKERNELS_BUILD_CUDA=ON \
    -DVKERNELS_BUILD_HIP=OFF \
    -DVKERNELS_BUILD_TESTS=ON \
    -DVKERNELS_BUILD_BENCHMARKS=ON \
    -DCMAKE_BUILD_TYPE=Release \
    && env \
       LIBRARY_PATH=/usr/local/cuda/targets/x86_64-linux/lib/stubs \
       LD_LIBRARY_PATH=/usr/local/cuda/targets/x86_64-linux/lib/stubs \
       cmake --build build-cuda -j$(nproc) \
    && grep -q '^VKERNELS_HAS_NCCL:BOOL=ON$' build-cuda/CMakeCache.txt

# ------------------------------------------------------------------
# Verify toolchain
# ------------------------------------------------------------------
RUN python3 -c "import torch; print('torch', torch.__version__, 'cuda=', torch.cuda.is_available())" \
    && dpkg-query -W libnccl2 libnccl-dev \
    && test -f /usr/include/nccl.h \
    && ldconfig -p | grep -q 'libnccl\.so' \
    && nvcc --version \
    && nsys --version \
    && ncu --version

CMD ["bash", "-c", "\
echo '=== vkernels tests ===' && \
cd /workspace/vkernels/build-cuda && ctest --output-on-failure && \
echo && echo '=== vkernels moe benchmark ===' && \
./meta/benchmarks/moe_bench && \
echo && echo '=== vkernels p2p gather benchmark ===' && \
./meta/benchmarks/p2p_gather_bench && \
echo && echo '=== vkernels p2p kv restore benchmark ===' && \
./meta/benchmarks/p2p_kv_restore_bench \
"]
