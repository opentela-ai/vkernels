# vkernels CUDA profiling toolchain (lightweight, no PyTorch)
#
# Self-contained image with:
#   * nvcc   (from the base image)                    — compile CUDA kernels
#   * ncu    Nsight Compute  (from the base image)    — per-kernel profiling
#   * nsys   Nsight Systems (installed below)         — whole-program timeline
#   * cmake + ninja + g++                              — host-side builds
#
# Override the target architecture at build time:
#   docker build --build-arg CUDA_ARCHS="90" -t vkernels/prof \
#       -f meta/docker/Dockerfile.prof meta/docker
#
# NOTE: On hosts where the NVIDIA Container Toolkit has `no-cgroups = true`
# (NVML fails inside `--gpus all` containers), combine `--gpus all` with
# explicit `--device-cgroup-rule` entries.  See meta/docker/run-profile.sh.
FROM nvidia/cuda:13.0.0-devel-ubuntu24.04

ARG CUDA_ARCHS=native

ENV DEBIAN_FRONTEND=noninteractive
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

RUN apt-get update && apt-get install -y --no-install-recommends \
      cmake \
      ninja-build \
      nsight-systems-2025.1.3 \
      python3 \
      pciutils \
    && rm -rf /var/lib/apt/lists/*

# nvcc / ncu already live in /usr/local/cuda/bin in the base image.
ENV PATH=/usr/local/cuda/bin:${PATH}

WORKDIR /work

# Smoke-check the toolchain at build time (no GPU required to list versions).
RUN nvcc --version | tail -1 \
 && ncu  --version | tail -1 \
 && nsys --version | head -1
